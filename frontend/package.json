{
  "name": "easy-agent",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "node scripts/run-vite.mjs dev",
    "test:unit": "node --test src/utils/*.test.js src/features/knowledge/utils/*.test.js src/features/personnel/*.test.js",
    "build": "node scripts/run-vite.mjs build && sh scripts/generate-runtime-config.sh",
