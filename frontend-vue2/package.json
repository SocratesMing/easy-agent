{
  "name": "easy-agent",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "node ../scripts/dev/sync-frontend-shared.mjs && node scripts/run-vite.mjs dev",
    "build": "node ../scripts/dev/sync-frontend-shared.mjs && node scripts/run-vite.mjs build",
    "sync:shared": "node ../scripts/dev/sync-frontend-shared.mjs",
    "preview": "vue-cli-service preview",
    "test:unit": "node --test src/api/*.test.js src/utils/*.test.js src/directives/*.test.js src/features/knowledge/utils/*.test.js src/features/personnel/*.test.js",
    "lint:vue2": "node scripts/check-vue2-syntax.mjs",
    "build:sdk": "node scripts/build-sdk.mjs",
    "serve": "node scripts/print-serve-env.mjs && npx --yes serve -s dist/"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "core-js": "^3.50.0",
    "docx-preview": "^0.3.7",
    "element-ui": "^2.15.14",
    "exceljs": "^3.4.0",
    "gemoji": "^8.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "marked": "^17.0.6",
    "marked-emoji": "^2.0.3",
    "marked-katex-extension": "^5.1.10",
    "monaco-editor": "^0.53.0",
    "vue": "^2.7.16",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.44",
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "unplugin-icons": "^23.0.1"
  },
  "overrides": {
    "braces": ">=3.0.3",
    "tar": ">=7.5.11",
    "micromatch": ">=4.0.8"
  }
}
