# 复制为 .env 后填写真实值（.env 不入库）

# ===== MySQL（与主应用共用同一个库，只读校验 mcp_api_keys） =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent
MYSQL_CHARSET=utf8mb4

# 连接池上限（进程内）。MySQL 在 skip_name_resolve=OFF 时每建一个连接都要反解
# 客户端 IP，本地实测约 130ms，所以池会在**首次查询时**一次性预热到这个数量
# （代价 N × 130ms，之后任何并发查询都不再等待）。多进程部署时实际连接数 =
# 进程数 × 该值，需小于 MySQL 的 max_connections。缺省 5
MYSQL_POOL_SIZE=5

# ===== API Key 校验结果缓存（秒）。吊销后最多在此时间内仍可能被放行 =====
MCP_KEY_CACHE_TTL=60

# ===== 关闭超时（秒）：Ctrl+C 后最多等多久让进行中的请求收尾，缺省 5 =====
# uvicorn 的 --timeout-graceful-shutdown 不覆盖 lifespan 收尾，这里是第二道兜底
# MCP_SHUTDOWN_TIMEOUT=5

# ===== 问数业务 dataqa（复用上面的 MYSQL_* 连接主库，无需单独配库） =====
# 单次查询返回行数上限，缺省 500
DATAQA_MAX_ROWS=500
# 单次查询超时（毫秒），缺省 10000
DATAQA_QUERY_TIMEOUT_MS=10000
# 表级白名单：配置后只暴露这些表/视图（逗号分隔）。留空表示不限制（仍屏蔽敏感表）
# 建议只放开 XBOND 长表视图与基表，避免模型看到主库全部业务表：
# DATAQA_ALLOWED_TABLES=v_xbond_depth,fmut_mkt_bonddpanyhis
# 追加屏蔽的表名（逗号分隔）
# DATAQA_DENY_TABLES=users,orders

# ===== XBOND 债券行情（dataqa 下的领域场景） =====
# 5 档宽表基表与长表视图名（视图由 seed 幂等创建）
XBOND_TABLE=fmut_mkt_bonddpanyhis
XBOND_VIEW=v_xbond_depth
# "近 N 天"的默认窗口，缺省 30
XBOND_DEFAULT_DAYS=30

# ===== 外汇行情问数业务 hbaseqa（HBase Thrift，只读 scan） =====
# Thrift Server 地址。注意：直连 Thrift，**用不到 ZooKeeper 端口**（ZK 只在用
#  Phoenix 厚驱动或 ZK 服务发现时才需要，本业务都不是）
HBASEQA_THRIFT_HOST=127.0.0.1
HBASEQA_THRIFT_PORT=9090
# Thrift 单次调用超时（毫秒），缺省 10000
HBASEQA_TIMEOUT_MS=10000
# 传输层与协议，必须与服务端一致；配错时服务端会直接掐断连接
# （Windows 上表现为 WinError 10053/10054）。拿不准就把 buffered 换成 framed 再试
HBASEQA_THRIFT_TRANSPORT=buffered
HBASEQA_THRIFT_PROTOCOL=binary
# 连接类错误的尝试次数，缺省 2（失败后重置连接重试 1 次）。
# Thrift Server 会回收空闲连接，长连接单例容易打空，不建议设为 1
HBASEQA_CONNECT_ATTEMPTS=2

# 单次工具返回行数上限，缺省 500
HBASEQA_MAX_ROWS=500
# 默认取数粒度：auto（缺省）/ raw / latest / hourly / daily。
# auto = 窗口超过 AUTO_COARSEN_HOURS 就自动降为 daily，并在 notes 里说明原因。
# 一个月明细约 13 万行，强烈建议保持 auto。
HBASEQA_GRANULARITY=auto
# auto 模式下超过多少小时就降采样，缺省 48
HBASEQA_AUTO_COARSEN_HOURS=48
# list_contracts 的扫描行数预算，缺省 5000（它只需"有哪些合约"，不必读满窗口）
HBASEQA_CONTRACT_SCAN_BUDGET=5000
# 单次 scan 最多读多少行（HBase 没有 LIMIT，这是应用层硬止损），缺省 50000
HBASEQA_MAX_SCANNED_ROWS=50000
# 单次取数的**时间**预算（毫秒），缺省 8000。行数预算挡的是内存、挡不住耗时，
# 而 MCP 客户端等响应头是有超时的（streamable_http 走 read 超时，缺省 300s）：
# 超时后连接被掐断、异常被 anyio 包成 ExceptionGroup，前端只看到
# "unhandled errors in a TaskGroup"，白等几分钟还没有结果。
# 到点会带着已扫到的数据返回，并在 notes 里说明"时间预算用尽"。
# 生产可放宽到 15000~20000，前端等待体感更好；开发想秒回可设 3000。
HBASEQA_SCAN_BUDGET_MS=8000
# 一次 getScannerRows 取多少行，缺省 5000。RPC 次数是扫描耗时的大头：
# 5 万行按 1000/次要 50 次串行 RPC，按 5000/次只要 10 次。
HBASEQA_SCAN_BATCH_ROWS=5000
# 未给时间时的默认回看窗口（小时），缺省 6
HBASEQA_DEFAULT_WINDOW_HOURS=6
# 毫秒时间戳按哪个时区渲染成可读时间，缺省 Asia/Shanghai
HBASEQA_TZ=Asia/Shanghai

# 业务数据的列族，缺省 CF
HBASEQA_COLUMN_FAMILY=CF
# BUYSELL 允许的取值，缺省 BID,ASK,MID
# HBASEQA_BUYSELL_VALUES=BID,ASK,MID

# 表级可见性：默认只暴露带业务前缀的表
HBASEQA_TABLE_PREFIX=HSDC_HDS2_
# 放开全部表（含非业务前缀）填 1
# HBASEQA_LIST_ALL_TABLES=1
# 白名单，配置后只暴露这些表（逗号分隔）。四张外汇行情表：
# HBASEQA_ALLOWED_TABLES=HSDC_HDS2_UBS_FXSPOT_BAR_DEPTH,HSDC_HDS2_JPMC_FXSPOT_BAR_DEPTH,HSDC_HDS2_UBS_FXFWD_BAR_DEPTH,HSDC_HDS2_BEST_HO_FXSPOT_BAR_BEST
# 追加屏蔽的表名（逗号分隔）
# HBASEQA_DENY_TABLES=

# rowkey 形态：ts=纯毫秒时间戳（可用 rowkey 做范围过滤，最快）、
# unknown=不是纯时间戳（退回 CF:TIME 列过滤）。先用 sample_rows 看 rowkey 再定
HBASEQA_ROWKEY_LAYOUT=ts
# 额外再加一层 CF:TIME 列过滤（rowkey 已经是 ts 时通常不需要）
# HBASEQA_TIME_COLUMN_FILTER=1
# 反向扫描（order='desc' 时用 Thrift2 的 TScan.reversed 让服务端反向扫）
# HBASEQA_REVERSE_SCAN=1

# Kerberos：当前集群未启用，配置口径先预留。真正启用时在
# businesses/hbaseqa/client.py::_open_connection 里把 Thrift 传输换成 SASL 传输即可
# HBASEQA_KERBEROS_ENABLED=1
# HBASEQA_KERBEROS_PRINCIPAL=hbase-queryserver@EXAMPLE.COM
# HBASEQA_KERBEROS_KEYTAB=/etc/security/keytabs/hbase.keytab
# HBASEQA_KERBEROS_SERVICE=hbase
# HBASEQA_KERBEROS_REALM=EXAMPLE.COM

# ===== 传输安全 =====
# FastMCP 对 127.0.0.1/localhost 默认开启 DNS rebinding 保护。
# 通过域名或反向代理访问时，不配置会全部返回 421，必须显式放行（逗号分隔）。
# 注意："host:*" 模式只匹配带端口的 Host；https 默认端口的 Host 不带端口，
# 所以必须把两种写法都列上：
# MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*
# MCP_ALLOWED_ORIGINS=https://mcp.example.com
