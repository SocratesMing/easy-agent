# 复制为 .env 后填写真实值（.env 不入库）

# ===== MySQL（与主应用共用同一个库，只读校验 mcp_api_keys） =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent
MYSQL_CHARSET=utf8mb4

# ===== API Key 校验结果缓存（秒）。吊销后最多在此时间内仍可能被放行 =====
MCP_KEY_CACHE_TTL=60

# ===== 关闭超时（秒）：Ctrl+C 后最多等多久让进行中的请求收尾，缺省 5 =====
# uvicorn 的 --timeout-graceful-shutdown 不覆盖 lifespan 收尾，这里是第二道兜底
# MCP_SHUTDOWN_TIMEOUT=5

# ===== 问数工具包 querykit（共享：SQL 只读网关 + MySQL 连接池 + 表探索） =====
# 单次查询返回行数上限，缺省 500
QUERYKIT_MAX_ROWS=500
# 单次查询超时（毫秒），缺省 10000
QUERYKIT_TIMEOUT_MS=10000
# 连接池上限，同时也是**预热数量**，缺省 5。
# MySQL 在 skip_name_resolve=OFF 时每建一个连接都要反解客户端 IP（本地实测约 130ms），
# 所以池会在首次查询时一次性建好这些连接，之后任何并发查询都不再等待。
# 多进程部署时实际连接数 = 进程数 × 该值，需小于 MySQL 的 max_connections。
QUERYKIT_POOL_SIZE=5

# ===== 策略问数业务 strategyqa（表 fmut2_strategy_manage） =====
# 表名，缺省 fmut2_strategy_manage
STRATEGY_TABLE=fmut2_strategy_manage
# 表级白名单：配置后只暴露这些表（逗号分隔），留空表示不限制（仍屏蔽敏感表）
# STRATEGY_ALLOWED_TABLES=fmut2_strategy_manage
# 追加屏蔽的表名（逗号分隔）
# STRATEGY_DENY_TABLES=

# ===== 外汇 K 线业务 fxbar（表 HSDC_HDS2_BAR_FX） =====
# 表名，缺省 HSDC_HDS2_BAR_FX
FX_TABLE=HSDC_HDS2_BAR_FX
# 表所在库。留空 = 用上面 MYSQL_DATABASE 指向的库。
# 外汇表若在另一个 database（常见，可能是列存引擎），在这里填库名，无需改代码。
# FX_SCHEMA=hsdc
# 缺省渠道（逗号分隔）。需求为 BEST / FXALL 两个；查询时传 channel=ALL 可放开全部
FX_CHANNELS=BEST,FXALL
# 缺省 K 线频率：1M / 5M / 15M / 1H / 4H / 1D
FX_DEFAULT_FREQUENCY=1H
# 不传时间参数时默认返回"最近 N 小时"（大表保护：避免全表扫）
FX_DEFAULT_WINDOW_HOURS=24
# 显式时间范围的上限（天）。超过会从结束时间往前自动收敛，并在返回里标记 clamped
FX_MAX_WINDOW_DAYS=31
# 表级白名单：建议配置，避免模型看到该库其它表
# FX_ALLOWED_TABLES=HSDC_HDS2_BAR_FX
# 追加屏蔽的表名（逗号分隔）
# FX_DENY_TABLES=

# ===== 投资研究业务（原 investment_research 已拆为 6 个独立业务包，共 16 张表） =====
# 各场景的表若在另一个 database，填对应 SCHEMA 即可，无需改代码。
# **若这些表都在 MYSQL_DATABASE 指向的同一个库里（内网现状就是如此），
# 下面所有 *_SCHEMA 全部留空即可，无需取消注释。**
# 结构探索白名单：代码里缺省已限定为各业务自己的那几张表，一般无需再配。
# 追加屏蔽的表名（逗号分隔）：<对应前缀>_DENY_TABLES

