# 复制为 .env 后填写真实值（.env 不入库）

# ===== MySQL（与主应用共用同一个库，只读校验 mcp_api_keys） =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent
MYSQL_CHARSET=utf8mb4

# ===== API Key 校验结果缓存（秒）。吊销后最多在此时间内仍可能被放行 =====
MCP_KEY_CACHE_TTL=60

# ===== 传输安全 =====
# FastMCP 对 127.0.0.1/localhost 默认开启 DNS rebinding 保护。
# 通过域名或反向代理访问时，不配置会全部返回 421，必须显式放行（逗号分隔）。
# 注意："host:*" 模式只匹配带端口的 Host；https 默认端口的 Host 不带端口，
# 所以必须把两种写法都列上：
# MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*
# MCP_ALLOWED_ORIGINS=https://mcp.example.com
