# Easy Agent Configuration
# Copy this file to config.yaml and fill in your API key
#
# Configuration File Locations (in priority order):
# 1) easy_agent/config/config.yaml - Development mode (current directory)
# 2) ~/.easy-agent/config/config.yaml - User config directory
# 3) <package>/easy_agent/config/config.yaml - Package installation directory

# ===== LLM Configuration =====
# Select which model to use: minimax | deepseek | ark
model: "deepseek"

# Provider-specific configurations
models:
  minimax:
    provider: "minimax"
    protocol: "anthropic"  # anthropic or openai
    api_key: "YOUR_MINIMAX_API_KEY"
    model: "MiniMax-M3"
    api_base: "https://api.minimaxi.com/anthropic"  # China users; Global: https://api.minimax.io/anthropic
    max_input_tokens: 200000  # Model context window size, used for summarization threshold calculation

  deepseek:
    provider: "deepseek"
    protocol: "openai"  # anthropic or openai
    model: "deepseek-v4-flash"
    api_key: "YOUR_DEEPSEEK_API_KEY"
    api_base: "https://api.deepseek.com"
    max_input_tokens: 200000

  ark:
    provider: "ark"
    protocol: "openai"  # anthropic or openai
    model: "deepseek-v4-pro"
    api_key: "YOUR_ARK_API_KEY"
    api_base: "https://ark.cn-beijing.volces.com/api/coding/v3"
    max_input_tokens: 200000

# ===== Retry Configuration =====
retry:
  enabled: true           # Enable retry mechanism
  max_retries: 3          # Maximum number of retries

# ===== Agent Configuration =====
max_steps: 100  # Maximum execution steps
workspace_dir: "./workspace"  # Working directory (project-relative). 实际路径会按用户/会话隔离：{workspace_dir}/{username}/{session_dir}
memories_dir: "./memories"    # Long-term memory directory (project-relative). 实际路径：{memories_dir}/{username}/AGENTS.md
system_prompt_path: "system_prompt.md"  # System prompt file (same config directory)

# 外部目录映射：虚拟路径前缀 → 宿主机实际路径
# 将 skill 需要访问的宿主机目录挂载为虚拟路径路由，使文件工具能通过虚拟路径访问
# external_dirs:
#   "/strategy-workspace": "/home/sututu/code/finance-skills/fast_backtest/workspace"
external_dirs: {}

# ===== Summarization Configuration =====
# Auto-compress conversation context when token usage exceeds threshold
summarization:
  enabled: true                    # Enable context compression
  compression_threshold: 0.8       # Trigger compression at 80% of context window
  compression_target: 0.1          # Keep 10% of context window after compression

# ===== Tools Configuration =====
tools:
  result_log_truncate: 200  # 工具结果在日志中的截断字符数（默认 200）
  skills_dir: "./skills"   # Skills directory path
  prompts_dir: "./prompts" # Prompts directory path (for forex, bloom, etc.)

# ===== Preset Questions =====
# Quick action questions shown on the welcome screen
preset_questions:
  - "帮我创建一份智能体介绍的docx"
  - "帮我生成一份金融量化的pptx"

# ===== Database Configuration =====
# Supports SQLite (local) or MySQL (remote)
database:
  type: "sqlite"

  sqlite:
    path: "./data/easy_agent.db"

  mysql:
    host: "127.0.0.1"
    port: 3306
    user: "root"
    password: "YOUR_MYSQL_PASSWORD"
    database: "easy_agent"
    charset: "utf8mb4"
    pool:
      pool_size: 5
      max_overflow: 10
      pool_timeout: 30
      pool_recycle: 3600
    connect_timeout: 10
    read_timeout: 30
    write_timeout: 30

# ===== Vector Store Configuration (Chroma + Sentence Transformers) =====
vector_store:
  enabled: false
  db_path: "./data/chroma_db"
  collection_name: "easy_agent_docs"
  embedding_provider: "sentence_transformers"
  embedding_dimension: 1024
  batch_size: 32
  sentence_transformers_model: "Qwen/Qwen3-Embedding-0.6B"
  zhipu_api_key: ""
  zhipu_model: "embedding-3"

# 禁止智能体读写的虚拟路径目录列表（通过 permissions deny 规则限制）
# 路径必须是虚拟路径（以 / 开头），且必须是 CompositeBackend 已挂载的 route 前缀。
# 系统会自动为路径补充 /** glob 通配符递归匹配子目录。
# 支持两种格式：
#   - 字符串："/strategy-workspace"                       → 默认禁止 read+write
#   - 字典：  {path: "/user-skills", operations: ["write"]} → 只禁止指定操作
# operations 可选值：read、write。user-skills 建议只禁止 write，
# 允许模型读取 SKILL.md 和 reference 文件以正常使用技能。
denied_dirs:
  - path: "/user-skills"
    operations: ["write"]
