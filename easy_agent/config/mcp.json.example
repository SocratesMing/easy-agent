{
  "servers": {
    "strategyqa": {
      "transport": "streamable_http",
      "url": "http://<mcp-server 地址>:8174/mcp/strategyqa/",
      "headers": {
        "Authorization": "Bearer <在设置页生成的 StrategyQA MCP API Key>"
      }
    },
