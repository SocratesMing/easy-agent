# ============================================================
# Easy Agent 后端环境变量 —— dev 环境
#
# 加载规则（easy_agent/utils/env_loader.py）：
#   AGENT_ENV=dev → 优先读项目根 .env.dev，不存在则回退 .env
# 与 config.yaml 的关系：yaml 里的 ${VAR:-默认值} 占位符由这里的变量填充，
#   未列出的变量走 yaml 内默认值（= 开发环境取值）。
# 注意：本文件含密钥，勿提交（.env.* 已 gitignore，仅 .env.*.example 入库）。
# ============================================================

# ── 密钥（必填；未设置的 provider 会从前端模型列表中被隐藏）──
DEEPSEEK_API_KEY=
ARK_API_KEY=

# ── 联网搜索（复用同一套 ${VAR} 配置加载逻辑）──
# provider: tavily（默认，https://api.tavily.com/search，key 在 https://app.tavily.com 申请）
#         | internal（内网 WebSearch 接口，见《联网搜索接口文档》）
# api_url 留空即用 provider 默认地址；未配置 api_key 时前端按钮置灰、后端不注入搜索工具
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=
# 可选（留空即用 config.yaml 默认值）：
#   WEB_SEARCH_SEARCH_DEPTH / WEB_SEARCH_TOPIC / WEB_SEARCH_TIMEOUT
#   WEB_SEARCH_TIME_RANGE / WEB_SEARCH_MAX_RESULTS / WEB_SEARCH_MAIN_TEXT_CHARS

# ── MySQL ──
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ── 知识库 / RAG（Ragflow v0.26.3 标准 API，可选）──
# 总开关：true 时下方两项必填，否则后端启动报错
KNOWLEDGE_ENABLED=false
# Ragflow 服务地址（本地部署示例：http://192.168.88.100:80）
RAGFLOW_BASE_URL=
# Ragflow System API token（在 Ragflow Web 界面生成）
RAGFLOW_API_KEY=
# 指定既有数据集 ID（可选）：非空时共享库直接使用该数据集，不查找/不创建；
# 留空则按 EA_SHARED 名称查找共享数据集，没有时自动创建
RAGFLOW_SHARED_DATASET_ID=
# embedding 模型（可选）：配置后创建数据集使用该模型；
# 留空由 RAGFlow 使用其默认 embedding 模型
RAGFLOW_EMBEDDING_MODEL=
# ── 外部目录树同步（可选；knowledge.catalog_sync 开关）──
# 开启后启动时将 SQL dump（kb_catalog/kb_doc）执行到外部 MySQL 的 ai_kb 库，
# 并按目录树（库/年/月/日/机构）自动创建知识库与文件夹
KNOWLEDGE_CATALOG_SYNC_ENABLED=false
# SQL dump 文件绝对或相对项目根的路径
KNOWLEDGE_CATALOG_SYNC_SQL_FILE=
# 执行 dump 的目标 MySQL 库名（不存在时自动创建）
KNOWLEDGE_CATALOG_SYNC_DATABASE=ai_kb

# ── JWT（不设置则每次启动随机生成，重启后所有登录态失效）──
EASY_JWT_SECRET=

# HITL 官方 checkpointer。留空则单机走官方 SQLite / 业务库回退。
# EASY_CHECKPOINT_POSTGRES_URI=postgresql://user:password@host:5432/dbname?sslmode=disable
# 生产多副本逃生门，默认关闭（仅单机调试时设为 1）。
# EASY_ALLOW_LEGACY_CHECKPOINTER=0

# ── HITL checkpointer / 结构化记忆 / MCP 证据链（2026-10-18）──
# EASY_CHECKPOINT_BACKEND=auto            # auto | postgres | sqlite | legacy
# EASY_CHECKPOINT_SQLITE_PATH=data/checkpoints.db
# Store：auto 在 Postgres URI 存在时用官方 AsyncPostgresStore，否则业务库 SqlStore。
# EASY_STORE_BACKEND=auto                 # auto | postgres | sql
# EASY_STORE_POSTGRES_URI=                # 留空复用 EASY_CHECKPOINT_POSTGRES_URI
# EASY_STRUCTURED_MEMORY=1                # 0/false/off 回退旧 Markdown 行为
# EASY_MCP_MAX_CONTENT_CHARS=20000
# EASY_RATE_LIMIT_BACKEND=auto        # auto | db | memory（多副本建议 db）

# ── 分布式锁（多 pod / 多 worker 部署开启）──
# 定时任务在每个 pod 都会注册同一批 cron，开启后同一时刻只有一个实例真正执行。
# 单实例部署保持 false 即可（关闭时不产生任何额外数据库访问）。
DISTRIBUTED_LOCK_ENABLED=false
# 可选：DISTRIBUTED_LOCK_KEY_PREFIX / DISTRIBUTED_LOCK_TTL
#       DISTRIBUTED_LOCK_RENEW_INTERVAL / DISTRIBUTED_LOCK_RETRY_INTERVAL

# ── 环境差异（对应 config.yaml 的 ${VAR:-默认值}）──
MAX_STEPS=100
IDLE_LOGOUT_MINUTES=0
WORKSPACE_DIR=/qts/workspace
MEMORIES_DIR=/qts/memories
SESSIONS_DIR=/qts/sessions
SQLITE_PATH=/qts/data/easy_agent.db
MYSQL_POOL_SIZE=5
STRATEGY_WORKSPACE=/qts/workspace
SKILLS_DIR=/qts/skills
PROMPTS_DIR=/qts/prompts
DEEPSEEK_CONTEXT_LENGTH=1000000

# 说明：以下变量留空/不写即使用 config.yaml 内默认值。
# 变量总清单（24 个占位符，对应 config-example.yaml 的 models：deepseek / ark）：
#   ACTIVE_MODEL / DEEPSEEK_MODEL / DEEPSEEK_API_KEY / DEEPSEEK_CONTEXT_LENGTH
#   ARK_MODEL / ARK_API_KEY / ARK_CONTEXT_LENGTH
#   MAX_STEPS / WORKSPACE_DIR / MEMORIES_DIR / SESSIONS_DIR / IDLE_LOGOUT_MINUTES
#   SANDBOX_ENABLED / STRATEGY_WORKSPACE / SKILLS_DIR / PROMPTS_DIR
#   DB_TYPE / SQLITE_PATH / MYSQL_POOL_SIZE
#   MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE
#   WEB_SEARCH_ENABLED / WEB_SEARCH_API_URL / WEB_SEARCH_API_KEY / WEB_SEARCH_TIMEOUT
#   WEB_SEARCH_TIME_RANGE / WEB_SEARCH_MAX_RESULTS / WEB_SEARCH_MAIN_TEXT_CHARS
