# ============================================================
# Easy Agent 后端环境变量 —— prod 环境
#
# 加载规则（easy_agent/utils/env_loader.py）：
#   AGENT_ENV=prod → 优先读项目根 .env.prod，不存在则回退 .env
# 与 config.yaml 的关系：yaml 里的 ${VAR:-默认值} 占位符由这里的变量填充，
#   未列出的变量走 yaml 内默认值（= 开发环境取值）。
# 注意：本文件含密钥，勿提交（.env.* 已 gitignore，仅 .env.*.example 入库）。
# ============================================================

# ── 密钥（必填；未设置的 provider 会从前端模型列表中被隐藏）──
DEEPSEEK_API_KEY=
ARK_API_KEY=

# ── 联网搜索（复用同一套 ${VAR} 配置加载逻辑）──
# provider: tavily（默认）| internal（内网 WebSearch 接口，生产需申请 api-key 并开通网络防控）
# api_url 留空即用 provider 默认地址；未配置 api_key 时前端按钮置灰
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=
# 可选：WEB_SEARCH_SEARCH_DEPTH / WEB_SEARCH_TOPIC / WEB_SEARCH_TIMEOUT
#       WEB_SEARCH_TIME_RANGE / WEB_SEARCH_MAX_RESULTS / WEB_SEARCH_MAIN_TEXT_CHARS

# ── MySQL ──
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ── JWT（生产必填；未设置时启动直接失败，且不会回退 data/.jwt_secret）──
# 通过部署 Secret 注入 >=32 字节随机值，例如: openssl rand -base64 48
# dev/test 未设置时仍回退 data/.jwt_secret（单机多 worker 可共享同一文件）。
EASY_JWT_SECRET=

# ── 反向代理 / 限流真实 IP ──
# 仅当 Ingress/网关会覆盖 X-Forwarded-For / X-Real-IP 时设为 1；
# 否则客户端可伪造该头绕过按 IP 限流。
# EASY_TRUST_PROXY=0

# ── HITL checkpointer（单 pod + 官方 SQLite saver）──
# 应用业务库是 MySQL（MYSQL_*）；checkpoint 存在仓库根 data/ 下的 SQLite 文件里（容器里 data/ 挂卷）。
# 不配时 MySQL 业务库会回退进程内 checkpointer（不落库，重启后待审批状态丢失）。
# 这个文件不能放到 NAS 等网络盘上，多个 pod 也不能共用。
EASY_CHECKPOINT_SQLITE_PATH=data/checkpoints.db
# 多副本：每个 pod 一个文件，再由 Ingress 粘性会话把同一用户固定到一个 pod
# （docs/design/2026-10-21-per-pod-sqlite-checkpoints.md，k8s 见 deploy/k8s/）：
#   EASY_CHECKPOINT_SQLITE_PATH=data/checkpoints/{pod}.db  # {pod} 换成 EASY_POD_NAME / POD_NAME / HOSTNAME
#   EASY_STICKY_SESSIONS=1                                 # Ingress 配好 cookie 会话保持后再打开
#   EASY_CHECKPOINT_GC_INTERVAL=600                        # 补删已删除会话残留 checkpoint 的间隔（秒）
# 生产多副本只放行上面这种配置，其余组合启动时 fail-fast；
# 显式设为 1 可豁免（审批跨副本恢复不保证一致，默认 0 关闭）。
EASY_ALLOW_LEGACY_CHECKPOINTER=0

# ── HITL checkpointer / LangGraph Store / 结构化记忆 / MCP 证据链（2026-10-18）──
# EASY_CHECKPOINT_BACKEND=auto            # auto | sqlite | legacy
# LangGraph Store 固定用业务库 SqlStore，无需配置。
# EASY_STRUCTURED_MEMORY=1                # 0/false/off 回退旧 Markdown 行为
# EASY_MCP_MAX_CONTENT_CHARS=20000
# EASY_RATE_LIMIT_BACKEND=auto        # auto | db | memory（多副本建议 db）

# ── 分布式锁（多 pod / 多 worker 部署开启）──
# 定时任务在每个 pod 都会注册同一批 cron，开启后同一时刻只有一个实例真正执行，
# 避免任务被重复处理。生产为多副本部署故默认开启；单实例部署可置 false。
DISTRIBUTED_LOCK_ENABLED=true
# 可选：DISTRIBUTED_LOCK_KEY_PREFIX / DISTRIBUTED_LOCK_TTL
#       DISTRIBUTED_LOCK_RENEW_INTERVAL / DISTRIBUTED_LOCK_RETRY_INTERVAL

# ── 环境差异（对应 config.yaml 的 ${VAR:-默认值}）──
MAX_STEPS=100
IDLE_LOGOUT_MINUTES=5
WORKSPACE_DIR=./workspace
MEMORIES_DIR=./memories
SESSIONS_DIR=./sessions
SQLITE_PATH=./data/easy_agent.db
MYSQL_POOL_SIZE=10
STRATEGY_WORKSPACE=./workspace
SKILLS_DIR=./skills
PROMPTS_DIR=./prompts
DEEPSEEK_CONTEXT_LENGTH=200000
# 模型调用日志开关：true 时打印建模入口参数、每次发往 api_base 的完整请求与原始返回报文（含对话内容，仅排障开启）
EASY_LLM_REQUEST_LOG=false

# 说明：以下变量留空/不写即使用 config.yaml 内默认值。
# 变量总清单（24 个占位符，对应 config-example.yaml 的 models：deepseek / ark）：
#   ACTIVE_MODEL / DEEPSEEK_MODEL / DEEPSEEK_API_KEY / DEEPSEEK_CONTEXT_LENGTH
#   ARK_MODEL / ARK_API_KEY / ARK_CONTEXT_LENGTH
#   MAX_STEPS / WORKSPACE_DIR / MEMORIES_DIR / SESSIONS_DIR / IDLE_LOGOUT_MINUTES
#   SANDBOX_ENABLED / STRATEGY_WORKSPACE / SKILLS_DIR / PROMPTS_DIR
#   DB_TYPE / SQLITE_PATH / MYSQL_POOL_SIZE
#   MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE
#   WEB_SEARCH_ENABLED / WEB_SEARCH_API_URL / WEB_SEARCH_API_KEY / WEB_SEARCH_TIMEOUT
#   WEB_SEARCH_TIME_RANGE / WEB_SEARCH_MAX_RESULTS / WEB_SEARCH_MAIN_TEXT_CHARS

# ── 多副本容器（Phase 0 预留；Phase 2/3 完成前请保持 strict=0）──
# EASY_STREAM_BACKEND=local       # local | db | redis（db/redis 尚未实现，Phase 2）
# EASY_RUN_QUEUE=none             # none | db | redis（Phase 2）
# EASY_FILE_BACKEND=local         # local | s3 | store（Phase 1/3）
# EASY_UPLOAD_BACKEND=local       # local | store（上传原始文件；store=LangGraph Store 落库）
# EASY_SANDBOX=local              # local（默认 bwrap/Landlock）| langsmith（实验性远端 execute）
# LANGSMITH_API_KEY=...           # EASY_SANDBOX=langsmith 时必填
# EASY_LANGSMITH_SNAPSHOT=...     # 可选 sandbox 快照
# EASY_SANDBOX_REMOTE_ROOT=/workspace
# EASY_SANDBOX_SYNC_MAX_MB=20
# EASY_MULTI_REPLICA_STRICT=0     # 1 时生产多副本强制校验外置能力

# ── run 租约与中断恢复（多副本 Phase 2B）──
# Pod 崩溃后，租约过期的 running run 由各 pod 定期扫描收尾：标记 interrupted、
# 补 error 事件并释放它留下的会话流锁（启动时也扫一次）。设为 0 时只在启动时扫。
# EASY_RUN_LEASE_SECONDS=600       # run 租约（秒），每 5 分钟随心跳续约
# EASY_RUN_RECOVERY_INTERVAL=60    # 周期扫描的间隔（秒）

# ── 数据库迁移（多副本 Phase 3）──
# 生产多副本建议：迁移 Job 先跑 `python scripts/db/migrate_db.py`，
# 然后 Pod 设 EASY_AUTO_MIGRATE=0 只校验结构；默认 1（单机/开发自动迁移）。
# EASY_AUTO_MIGRATE=1
# EASY_MIGRATION_LOCK_TIMEOUT=120
