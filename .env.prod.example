# ============================================================
# Easy Agent 后端环境变量 —— prod 环境（统一基线）
#
# 三份 .env.*.example 使用完全相同的变量名集合与分组顺序，每项都显式写出非空值。
# 值为 EASY_AGENT_SET_ME__<变量名> 的是哨兵：代码视作「未配置」，dev/test 走安全默认值，
# prod 必须替换为真实值（EASY_JWT_SECRET / EASY_CORS_ALLOW_ORIGINS /
# EASYAGENT_BOOTSTRAP_ADMIN_PASSWORD 及各类 API key、数据库密码）。
#
# 加载规则（easy_agent/utils/env_loader.py）：AGENT_ENV=dev|test|prod 决定读
# .env.dev / .env.test / .env.prod；该文件必须由真实进程环境或容器 env 提供，
# 写在 .env 文件内部只能影响加载之后的逻辑。敏感值只写本地 .env.*，不提交。
# ============================================================

# ── 引导 / 环境加载 ──
# AGENT_ENV 必须由真实进程环境/容器 env 提供，写在 .env 文件里不能决定加载哪一个 .env；哨兵值仅用于模板占位。
AGENT_ENV=prod
EASY_ENV_FILE=.env.prod
EASY_ENV_OVERRIDE=0
EASY_CONFIG=easy_agent/config/config.yaml
EASY_CONFIG_STRICT=0
EASY_LOG_LEVEL=info
EASY_LLM_REQUEST_LOG=0

# ── 安全 / 账号 ──
# dev/test 的哨兵由代码生成安全默认值；prod 必须把三个安全哨兵替换为真实值，否则启动 fail-fast；EASY_DEFAULT_RESET_PASSWORD=123456 仅作开发默认，生产必须改。
EASY_JWT_SECRET=EASY_AGENT_SET_ME__EASY_JWT_SECRET
EASY_CORS_ALLOW_ORIGINS=EASY_AGENT_SET_ME__EASY_CORS_ALLOW_ORIGINS
EASYAGENT_BOOTSTRAP_ADMIN_PASSWORD=EASY_AGENT_SET_ME__EASYAGENT_BOOTSTRAP_ADMIN_PASSWORD
EASY_DEFAULT_RESET_PASSWORD=123456
EASY_TRUST_PROXY=0

# ── 模型 / LLM ──
# API key 留哨兵时对应 provider 不可用；ACTIVE_MODEL 指定当前使用的模型（deepseek / opencode）。
ACTIVE_MODEL=opencode
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=EASY_AGENT_SET_ME__DEEPSEEK_API_KEY
DEEPSEEK_CONTEXT_LENGTH=200000
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_API_KEY=EASY_AGENT_SET_ME__OPENCODE_API_KEY
OPENCODE_API_BASE=https://opencode.ai/zen/go/v1
OPENCODE_CONTEXT_LENGTH=1000000

# ── Agent / 路径 / 沙箱 ──
# 路径需指向本环境可写目录；生产不要沿用 /qts/* 开发路径。
MAX_STEPS=100
TOOL_PROGRESS_ENABLED=true
WORKSPACE_DIR=./workspace
MEMORIES_DIR=./memories
SESSIONS_DIR=./sessions
IDLE_LOGOUT_MINUTES=5
SANDBOX_ENABLED=true
SANDBOX_NETWORK=host
EXECUTE_MAX_TIMEOUT=600
SESSION_THREAD=true
STRATEGY_WORKSPACE=./workspace
SKILLS_DIR=./skills
PROMPTS_DIR=./prompts
EXPERTS_DIR=./experts

# ── 联网搜索 ──
# WEB_SEARCH_API_KEY 留哨兵时搜索按钮置灰。
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_URL=EASY_AGENT_SET_ME__WEB_SEARCH_API_URL
WEB_SEARCH_API_KEY=EASY_AGENT_SET_ME__WEB_SEARCH_API_KEY
WEB_SEARCH_SEARCH_DEPTH=basic
WEB_SEARCH_TOPIC=general
WEB_SEARCH_TIMEOUT=30
WEB_SEARCH_TIME_RANGE=NoLimit
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_MAIN_TEXT_CHARS=500

# ── 数据库 ──
# MYSQL_PASSWORD 为哨兵时 prod 多 worker 会启动失败；单 worker 会降级 SQLite。
DB_TYPE=mysql
SQLITE_PATH=./data/easy_agent.db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=EASY_AGENT_SET_ME__MYSQL_PASSWORD
MYSQL_DATABASE=easy_agent
MYSQL_POOL_SIZE=10

# ── 数据库迁移 ──
# 生产多副本先跑迁移 Job，再设 EASY_AUTO_MIGRATE=0。
EASY_AUTO_MIGRATE=1
EASY_MIGRATION_LOCK_TIMEOUT=120

# ── HITL checkpoint ──
# config.yaml 的 checkpoint.sqlite_path 优先；EASY_CHECKPOINT_SQLITE_PATH 仅在无该配置段时生效。
CHECKPOINT_DIR=/qts/checkpoint
EASY_CHECKPOINT_BACKEND=auto
EASY_CHECKPOINT_SQLITE_PATH=/qts/checkpoint/{pod}.db
EASY_ALLOW_LEGACY_CHECKPOINTER=0
EASY_STICKY_SESSIONS=0
EASY_CHECKPOINT_GC_INTERVAL=600

# ── 分布式锁 / 文件权限 ──
# 多 pod/多 worker 部署开启分布式锁。
DISTRIBUTED_LOCK_ENABLED=true
DISTRIBUTED_LOCK_KEY_PREFIX=easy_agent
DISTRIBUTED_LOCK_TTL=300
DISTRIBUTED_LOCK_RENEW_INTERVAL=100
DISTRIBUTED_LOCK_RETRY_INTERVAL=1
SKILL_WRITE=new-only

# ── 上传与文件上下文 ──
# 单次对话的上传大小与注入上限。
UPLOAD_LIMITS_ENABLED=true
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES=5
UPLOAD_MAX_TOTAL_SIZE_MB=20
FILE_CONTEXT_ENABLED=true
FILE_PARSE_MAX_MB=20
FILE_MAX_STORED_CHARS=200000
FILE_MANIFEST_MAX_CHARS=2000
FILE_PREVIEW_MAX_CHARS=2000

# ── 知识库 / RAGFlow / 研报同步 ──
# KNOWLEDGE_ENABLED=true 时 RAGFLOW_BASE_URL / RAGFLOW_API_KEY 必须替换为真实值。
KNOWLEDGE_ENABLED=false
RAGFLOW_BASE_URL=EASY_AGENT_SET_ME__RAGFLOW_BASE_URL
RAGFLOW_API_KEY=EASY_AGENT_SET_ME__RAGFLOW_API_KEY
RAGFLOW_SHARED_DATASET_ID=EASY_AGENT_SET_ME__RAGFLOW_SHARED_DATASET_ID
RAGFLOW_EMBEDDING_MODEL=EASY_AGENT_SET_ME__RAGFLOW_EMBEDDING_MODEL
KNOWLEDGE_PARSE_TIMEOUT_SECONDS=0
KNOWLEDGE_SOURCE_SYNC_ENABLED=false
SOURCE_SYNC_FILE_ROOT=EASY_AGENT_SET_ME__SOURCE_SYNC_FILE_ROOT
COL_SQL_HOST=EASY_AGENT_SET_ME__COL_SQL_HOST
COL_SQL_PORT=3306
COL_SQL_USER=EASY_AGENT_SET_ME__COL_SQL_USER
COL_SQL_PASSWORD=EASY_AGENT_SET_ME__COL_SQL_PASSWORD
COL_SQL_DB=EASY_AGENT_SET_ME__COL_SQL_DB
COL_SQL_CHARSET=utf8mb4
COL_SQL_TABLE=EASY_AGENT_SET_ME__COL_SQL_TABLE

# ── 多副本 / 沙箱 ──
# 平台注入项也写入模板，保证三套变量集合一致；哨兵键仅在启用对应功能时需要替换。
EASY_REPLICA_COUNT=1
EASY_POD_NAME=prod-pod
WEB_CONCURRENCY=1
UVICORN_WORKERS=1
EASY_STREAM_BACKEND=db
EASY_RUN_QUEUE=none
EASY_FILE_BACKEND=local
EASY_SANDBOX=local
EASY_MULTI_REPLICA_STRICT=0
EASY_SANDBOX_STRICT=0
EASY_SANDBOX_SYNC_MAX_MB=20
EASY_SANDBOX_REMOTE_ROOT=/workspace
LANGSMITH_API_KEY=EASY_AGENT_SET_ME__LANGSMITH_API_KEY
LANGCHAIN_API_KEY=EASY_AGENT_SET_ME__LANGCHAIN_API_KEY
EASY_LANGSMITH_SNAPSHOT=EASY_AGENT_SET_ME__EASY_LANGSMITH_SNAPSHOT

# ── 流式 / run / 限流 ──
# SSE 心跳、run 租约与中断恢复、限流后端。
EASY_RUN_LEASE_SECONDS=600
EASY_RUN_RECOVERY_INTERVAL=60
EASY_SSE_HEARTBEAT_SECONDS=15
EASY_WRITE_SESSION_CONTEXT=0
EASY_RATE_LIMIT_BACKEND=auto

# ── Agent / 服务开关 ──
# 功能灰度与调试开关，默认值即可运行。
EASY_ALLOW_DUPLICATE_SCHEDULER=0
EASY_PROMPTS_DIR=easy_agent/config/prompts
AGENT_WIN=auto
EASY_EXPERTS_DIR=./experts
EASY_UPLOAD_BACKEND=local
EASY_STRUCTURED_MEMORY=1
EASY_WEB_TERMINAL_ENABLED=0

# ── 图缓存 / LLM 探测 ──
# 启动期 LLM 探测在 prod 默认跳过。
EASY_AGENT_GRAPH_CACHE=1
EASY_AGENT_GRAPH_CACHE_SIZE=32
EASY_LLM_PROBE=0
EASY_SKIP_LLM_PROBE=0

# ── 兼容保留（旧模板遗留，梳理后可去掉） ──
# 这些变量当前代码/配置已不再消费，仅按「不删除无关变量」保留；梳理清单见验收报告。
SOURCE_SYNC_STAGING_DIR=EASY_AGENT_SET_ME__SOURCE_SYNC_STAGING_DIR
